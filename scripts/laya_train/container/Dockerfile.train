# No `# syntax=` directive on purpose: it would pull a floating frontend image (docker/dockerfile:1) that this file
# could not pin; the builder's built-in Dockerfile frontend is used.
#
# Phase 14 plan 14-06: the x86_64 CUDA training image (SageMaker ml.g5.xlarge, D-13). One program runs in it:
# run_step.py (ENTRYPOINT), which runs the pinned trainer scripts/laya_train/train.py UNCHANGED on the GPU and
# uploads the run. It never packs, verifies or recomputes a metric; x86_64 touches only torch.
#
# BUILD CONTEXT: exactly the paths in scripts/laya_train/container/context-paths.txt, assembled from the git index by
# the image recipe (plans 14-09 / 14-12) and passed as `docker build -f <ctx>/scripts/laya_train/container/Dockerfile.train
# <ctx>`. The repository root is NEVER the context (no .dockerignore, a 26 GB models/ tree). The real build is
# CodeBuild's on x86_64; on Apple silicon an x86 image only emulates, so the laptop runs `docker build --check` only.
#
# WHAT IS PINNED, AND WHAT IS NOT (the run's identity is the recorded image DIGEST, not a byte-identical rebuild):
#   pinned by digest or hash   the CUDA base image (@sha256, below), the uv image (@sha256), the aws CLI v2 zip
#                              (version + sha256, verified in the RUN), the python deps (uv.lock, `--frozen`: every
#                              wheel by hash; `laya` by full git commit SHA 4066d5d5), the contracts and scripts (COPY)
#   NOT pinned                 the apt packages (ca-certificates, curl, unzip, git, and cuda-compat-13-0 if the base ever
#                              stops shipping it): they resolve from the base image's Ubuntu / NVIDIA archives at build
#                              time. The uv-managed CPython 3.13.7 is fetched by uv (it checks its own download hashes).
#   never in the image         the base-model snapshot or any weights (the `base` channel carries laya-base.tar, verified
#                              against base-stage.json and extracted offline), pip installs, a hub download, and any
#                              determinism switch (D-17).
#
# Base image: nvidia/cuda 13.0.3-base-ubuntu24.04, index digest below (linux/amd64 child resolved at build time).
# Resolved 2026-10-29 with `docker buildx imagetools inspect nvidia/cuda:13.0.3-base-ubuntu24.04`. The linux/amd64 image
# was run once to confirm /usr/local/cuda/compat holds libcuda.so.580.126.20 (the compat libraries for hosts with an older
# driver; run_step.py puts them on LD_LIBRARY_PATH only when the host driver major is below 580 and records the choice).
# Size: torch's cu13 wheels and this base both carry a CUDA runtime; the image size is recorded when plan 14-12 builds it,
# and a slimmer base (ubuntu + cuda-compat only) is a recorded follow-up, not this plan's change.
FROM nvidia/cuda:13.0.3-base-ubuntu24.04@sha256:7c7413a56200486f71f181cad9310f6fd31b6bb21816ade15fc9c1e1e927a5c1

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl unzip git \
 && rm -rf /var/lib/apt/lists/*

# The CUDA compat libraries: confirm they ship with the base, install them if not, and FAIL THE BUILD when absent.
RUN if ! ls /usr/local/cuda/compat/libcuda.so.* >/dev/null 2>&1; then \
      apt-get update \
   && apt-get install -y --no-install-recommends cuda-compat-13-0 \
   && rm -rf /var/lib/apt/lists/*; \
    fi \
 && ls /usr/local/cuda/compat/libcuda.so.*

# uv 0.9.5, pinned by digest.
COPY --from=ghcr.io/astral-sh/uv:0.9.5@sha256:f459f6f73a8c4ef5d69f4e6fbbdb8af751d6fa40ec34b39a1ab469acd6e289b7 /uv /uvx /usr/local/bin/

# aws CLI v2 from the official zip, pinned by version and sha256 (the hash was taken from awscli.amazonaws.com over TLS
# on 2026-10-29 and is checked here; run_step.py uploads through `aws s3api put-object`).
ARG AWSCLI_VERSION=2.39.1
ARG AWSCLI_SHA256=5b6c10e0a8ccdcf30c84bd643fea511f103d257a4787a7cef878691d63169804
RUN curl -fsSL -o /tmp/awscliv2.zip "https://awscli.amazonaws.com/awscli-exe-linux-x86_64-${AWSCLI_VERSION}.zip" \
 && echo "${AWSCLI_SHA256}  /tmp/awscliv2.zip" | sha256sum -c - \
 && unzip -q /tmp/awscliv2.zip -d /tmp \
 && /tmp/aws/install \
 && rm -rf /tmp/aws /tmp/awscliv2.zip \
 && aws --version

# The repository subset, laid out exactly as on the laptop: contract.py finds REPO = parents[2] of scripts/laya_train.
COPY . /opt/laya/

# The trainer environment comes ONLY from the owner-verified lock (plan 14-03): no pip, no resolution.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_LINK_MODE=copy
WORKDIR /opt/laya/scripts/laya_train
RUN uv sync --frozen --no-dev

# Linux installability proof (14-03's open risk): a lock that does not install or import on Linux x86_64 fails the
# CodeBuild build here, before its push step. No CUDA call: the build host has no GPU.
RUN /opt/laya/scripts/laya_train/.venv/bin/python -c "import torch, transformers, numpy, safetensors, huggingface_hub, laya; print('IMPORT OK torch=%s transformers=%s numpy=%s safetensors=%s huggingface_hub=%s laya=%s' % (torch.__version__, transformers.__version__, numpy.__version__, safetensors.__version__, huggingface_hub.__version__, getattr(laya, '__version__', 'unversioned')))"

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# SageMaker runs the image with the single argument `train`.
ENTRYPOINT ["/opt/laya/scripts/laya_train/.venv/bin/python", "/opt/laya/scripts/laya_train/container/run_step.py"]
