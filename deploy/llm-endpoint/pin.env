# Pin for the internal OpenAI-compatible LLM endpoint image (phase 9, D-02 / D-13).
#
# The image's `apr` is a RELEASE artifact and nothing else: the aarch64 CPU tarball published on
# GitHub for APR_TAG, verified against BOTH the release's own .sha256 file and APR_TARBALL_SHA256
# below before it is extracted. A fork-build binary is never used (D-02).
#
# Re-pin = edit this file (APR_TAG, APR_ASSET, APR_TARBALL_SHA256, and APR_PIN_PROFILE when the
# release carries this phase's server fixes), then re-run `just llm-endpoint-image`, the probe and
# the live record. Plain KEY=value lines, sourceable by bash (`. deploy/llm-endpoint/pin.env`).
#
# The Dockerfile cannot read this file, so the Lambda Web Adapter digest is written twice: here and as
# a literal in the Dockerfile's first FROM line. `just llm-endpoint-image` refuses (`lwa-digest`)
# when the two differ.
APR_TAG=v0.71.4
APR_ASSET=apr-v0.71.4-aarch64-unknown-linux-gnu-cpu.tar.gz
APR_TARBALL_SHA256=f09b425e39d89182bda9a1aebf46e9b63f1fb99e495ffe8b112821e947be2db8
# baseline: this release carries none of this phase's server fixes. Flips to `fixed` on re-pin; the
# probe records it and the ladder-reader test keys on it.
APR_PIN_PROFILE=baseline
LWA_IMAGE=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1
LWA_IMAGE_DIGEST=sha256:46d6625e68cbbdd2efab4a20245977664513f13ffef47915b000d431adcea0b4
IMAGE_NAME=aprender-llm-endpoint
GGUF_RUNG=qwen35-0.8b-q4km
GGUF_OBJECT=Qwen3.5-0.8B-Q4_K_M.gguf
